# ─── Server-side keys (only needed for the CREDITS path) ─────────────────────
# In BYOK mode users paste their own keys in /settings and these stay unused.
OPENROUTER_API_KEY=
REPLICATE_API_TOKEN=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_ENABLED=false

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://videamax.com
# Secret used to sign the anonymous account cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCOUNT_COOKIE_SECRET=

# ─── Analytics (optional) ────────────────────────────────────────────────────
# The production GA4 property (G-JF6W1HVEDC) is built in, and only reports when
# the site is served from videamax.com. Localhost, previews and forks of this
# repo load no tag and send nothing, so you need neither of these to deploy.
# Consent is denied by default and the banner asks; see lib/analytics.ts.
#
# Point a deployment at a different property:
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Let any host report (testing only — this sends localhost traffic):
NEXT_PUBLIC_GA_ANY_HOST=

# ─── Credit ledger storage ───────────────────────────────────────────────────
# memory (default, dev only — wiped on restart) | upstash
CREDIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
